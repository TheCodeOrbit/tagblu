<script>
	$(document).ready(function(){
		var modulename = '<?php echo $ModuleName; ?>';
		var mode = $('#mode').val();
		if(mode=='Create'){
			//alert("Create Mode");
			//var block_id=$(this).attr('rel');
			var block_id=3;
			var geturl=getAbsoluteUrl();
			var url=geturl+'index.php/dailydrilling/ProductBlock';
								      	$.ajax({
												type: 'POST',
												url: url,
												data:'cnt_multiple_product='+cnt_multiple_product+'&blockid='+block_id,
												success:function(data){ 
												$('#Tbl_drilling_data tr:last').after(data);
												$(".drilling_type option[value='1']").attr("selected","selected");
												$('.drilling_type').trigger("chosen:updated");
												$(document.body).on('change', '.drilling_type' ,function(){
															code	= $(this).attr('id');
															codevals= $(this).val();
															seq_no	= code.substring(14,code.indexOf('_drilling_type'));
															if(codevals == 2 || codevals =='' ){
															$("#drilling_data_"+seq_no+"_bench_height").attr('readonly',true);
															}
															else{
															$("#drilling_data_"+seq_no+"_bench_height").attr('readonly',false);
															}
												});
											  cnt_multiple_product=cnt_multiple_product+1;
												$.getScript(geturl + '/js/Tetra/chosenCode.js');

												},
												error: function(data) { 
												},
												dataType:'html'    
												});

		}
		if(modulename =='users'){
			if(mode=='Create'){
				$('#yw0').submit(function(e){
				//alert(modulename);
					e.stopImmediatePropagation();
					var public_key=$('#publickey').val();
					var user_pass=$('#EditModel_user_password').val();
					
					var enc_user_pass=CryptoJS.AES.encrypt(JSON.stringify(user_pass), public_key, {format: CryptoJSAesJson}).toString();
					$('#EditModel_user_password').val(enc_user_pass);
				});
			}
		}
	});
</script> 
